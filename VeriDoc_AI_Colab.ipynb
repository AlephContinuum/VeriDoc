# @title 2. Define the OCR Engine and Data Parser
# Is cell mein hamara saara backend logic hai: OCREngine aur parse_fields function.

import torch
from PIL import Image
from transformers import TrOCRProcessor, VisionEncoderDecoderModel
import cv2
import numpy as np
import re

# --- ML Model Configuration ---
MODELS = {
    "printed": "microsoft/trocr-large-printed",
    "handwritten": "microsoft/trocr-large-handwritten"
}

class OCREngine:
    """TrOCR models aur unki functionality ko manage karne ke liye class."""
    def __init__(self):
        self.device = "cuda" if torch.cuda.is_available() else "cpu"
        self.models = {}
        self._load_models()

    def _load_models(self):
        """Config se saare TrOCR models load karne ke liye private method."""
        try:
            print("TrOCR models load ho rahe hain...")
            for model_type, model_name in MODELS.items():
                print(f"-> '{model_name}' load ho raha hai...")
                processor = TrOCRProcessor.from_pretrained(model_name)
                model = VisionEncoderDecoderModel.from_pretrained(model_name).to(self.device)
                self.models[model_type] = {"processor": processor, "model": model}
            print("Sabhi models successfully load ho gaye hain.")
        except Exception as e:
            print(f"CRITICAL: OCR models load karne mein error aaya. Error: {e}")

    def _preprocess_image(self, image: Image.Image) -> Image.Image:
        """OCR accuracy improve karne ke liye image preprocessing."""
        img_cv = np.array(image.convert('RGB'))
        gray = cv2.cvtColor(img_cv, cv2.COLOR_RGB2GRAY)
        _, thresh = cv2.threshold(gray, 0, 255, cv2.THRESH_BINARY | cv2.THRESH_OTSU)
        return Image.fromarray(thresh)

    def extract_text(self, image: Image.Image, doc_type: str, preprocess: bool = False) -> str:
        """Selected model use karke PIL Image object se text extract karta hai."""
        if doc_type not in self.models:
            return f"Error: '{doc_type}' type ke document ke liye model available nahi hai."

        engine = self.models[doc_type]
        processor = engine["processor"]
        model = engine["model"]

        try:
            if preprocess:
                image = self._preprocess_image(image)

            pixel_values = processor(images=image, return_tensors="pt").pixel_values.to(self.device)
            generated_ids = model.generate(pixel_values)
            extracted_text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]
            return extracted_text.strip()
        except Exception as e:
            return f"OCR process ke dauraan error aaya: {e}"

def parse_fields(text: str) -> dict:
    """Generic pattern use karke raw text se sabhi possible key-value pairs extract karta hai."""
    extracted_data = {}
    pattern = re.compile(r"^\s*([\w\s]+?)\s*(?::|---|by)\s*(.*?)\s*$", re.MULTILINE)
    matches = pattern.findall(text)
    
    for match in matches:
        key = match[0].strip().title().replace(" ", "_")
        value = match[1].strip()
        if key and value:
            extracted_data[key] = value
            
    if not extracted_data and text:
        extracted_data['raw_text'] = text

    return extracted_data

# Ek baar engine ko instantiate karein.
ocr_engine = OCREngine()
print("\nBackend logic taiyaar hai.")


# @title 3. Create the Streamlit App File
# Yeh cell hamara saara UI code 'app.py' naam ki file mein likh dega.
# Streamlit ko run karne ke liye ek file chahiye hoti hai.

%%writefile app.py
import streamlit as st
from PIL import Image
import pandas as pd
# Hum upar waale cell mein banaye gaye objects ko import kar rahe hain
from __main__ import ocr_engine, parse_fields

def run_ui():
    """Streamlit UI ko run karne ke liye main function."""
    st.set_page_config(page_title="VeriDoc AI", page_icon="🤖", layout="centered")
    st.title("VeriDoc AI: Document OCR & Verification")

    doc_type = st.radio(
        "1. Document Type Select Karein:",
        ('Printed', 'Handwritten'),
        horizontal=True
    )

    uploaded_file = st.file_uploader("2. Document Image Upload Karein", type=["png", "jpg", "jpeg"])
    preprocess = st.checkbox("Behtar accuracy ke liye image preprocessing apply karein")

    if uploaded_file is not None:
        image = Image.open(uploaded_file)
        st.image(image, caption="Uploaded Image", use_column_width=True)

        if st.button("Information Extract Karein"):
            with st.spinner("Processing..."):
                raw_text = ocr_engine.extract_text(image, doc_type=doc_type.lower(), preprocess=preprocess)
                
                st.subheader("Raw Extracted Text")
                st.text_area("OCR Output", raw_text, height=150)

                extracted_fields = parse_fields(raw_text)
                
                st.subheader("Extracted Information")
                if extracted_fields:
                    display_data = [[key.replace("_", " ").title(), value] for key, value in extracted_fields.items()]
                    df = pd.DataFrame(display_data, columns=["Field", "Extracted Value"])
                    st.table(df)
                else:
                    st.warning("Koi specific fields extract nahi ho paye.")

if __name__ == "__main__":
    run_ui()


